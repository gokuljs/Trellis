# Browser-safe values from your Supabase project's Connect dialog.
# Copy this file to frontend/.env and replace the placeholders.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Google/GitHub client secrets belong in Supabase provider settings.
# Never put a Supabase secret or service_role key in a VITE_ variable.

# Optional public Sentry configuration. Missing DSN disables reporting.
# See ../docs/frontend-sentry.md for activation rules and verification.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENABLED=true
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Production reporting uses a valid DSN automatically when the switch is unset.
# Development and custom modes require explicit VITE_SENTRY_ENABLED=true.
# VITE_SENTRY_ENABLED=false disables reporting everywhere.

# Build-only upload settings belong in CI configuration.
# Set SENTRY_ORG and SENTRY_PROJECT to your Sentry slugs.
# Inject SENTRY_AUTH_TOKEN through the CI secret store, never a VITE_ variable.
# Set VITE_SENTRY_RELEASE to the Git SHA, then run bun run build:sentry.
# The command sets SENTRY_UPLOAD_SOURCEMAPS=true and forces the web build.
