# Browser-safe values from your Supabase project's Connect dialog.
# Copy this file to frontend/.env and replace the placeholders.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Required for hosted builds. Set separately for Vercel Preview and Production.
# The WebSocket URL connects directly to the API, without a Vercel rewrite.
# Leave both unset in local development to use Vite's HTTP/WebSocket proxy.
# VITE_API_BASE_URL=https://your-api.onrender.com
# VITE_RUNTIME_WS_URL=wss://your-api.onrender.com/api/runtime

# Google/GitHub client secrets belong in Supabase provider settings.
# Never put a Supabase secret or service_role key in a VITE_ variable.
