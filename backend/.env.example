TRELLIS_APP_NAME=Trellis API
TRELLIS_ENVIRONMENT=development
TRELLIS_DEBUG=false
# Empty means chat-only. Local tools require explicit operator opt-in and a restart.
# Allowed values: local_read, local_patch, local_command.
TRELLIS_ENABLED_CAPABILITIES=[]
# Backend secrets only. Set either or both to make their models available.
# TRELLIS_OPENAI_API_KEY=
# TRELLIS_ANTHROPIC_API_KEY=
# TRELLIS_DATA_DIR=/absolute/path/to/trellis-data
# Copy this file to backend/.env and use the same Supabase project as the web app.
# Use only the project URL and publishable key. Never use a service-role or secret key.
# Hosted URL: https://<project-ref>.supabase.co; local development may use localhost HTTP.
TRELLIS_SUPABASE_URL=
TRELLIS_SUPABASE_PUBLISHABLE_KEY=
# Exact HTTPS origin serving the web app, for example https://app.example.com.
# Required for production WebSocket connections; no path, wildcard, or trailing slash.
TRELLIS_WEB_ORIGIN=
# Required in preview and production. Use Supabase Auth user UUIDs, not emails.
# Set preview and production origins, users, Supabase projects, and tokens separately.
TRELLIS_PRIVATE_USER_IDS=[]
TRELLIS_RELEASE=development
