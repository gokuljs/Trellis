TRELLIS_APP_NAME=Trellis API
TRELLIS_ENVIRONMENT=development
TRELLIS_DEBUG=false
# Empty means chat-only. Local tools require explicit operator opt-in and a restart.
# Allowed values: local_read, local_patch, local_command, web_search, web_read, web_crawl.
TRELLIS_ENABLED_CAPABILITIES=[]
# Active work is rejected above these limits; it is not placed in a queue.
TRELLIS_MAX_ACTIVE_RUNS=16
TRELLIS_MAX_ACTIVE_RUNS_PER_USER=4
# Backend secrets only. Set either or both to make their models available.
# TRELLIS_OPENAI_API_KEY=
# TRELLIS_ANTHROPIC_API_KEY=
# TRELLIS_DATA_DIR=/absolute/path/to/trellis-data
# Copy this file to backend/.env and use the same Supabase project as the web app.
# Use only the project URL and publishable key. Never use a service-role or secret key.
# Hosted URL: https://<project-ref>.supabase.co; local development may use localhost HTTP.
TRELLIS_SUPABASE_URL=
TRELLIS_SUPABASE_PUBLISHABLE_KEY=
# Exact HTTPS origin serving the web app, for example https://app.example.com.
# Required for production WebSocket connections; no path, wildcard, or trailing slash.
TRELLIS_WEB_ORIGIN=
# Required in preview and production. Use Supabase Auth user UUIDs, not emails.
# Set preview and production origins, users, Supabase projects, and tokens separately.
TRELLIS_PRIVATE_USER_IDS=[]
TRELLIS_RELEASE=development

# Public web tools require reviewed evidence migrations and an isolated Docker runtime.
# See docs/stage-7-operations.md for pinned images, private control credentials, and setup.
# Search uses a separate backend Brave key; the OpenAI key does not configure Brave.
# TRELLIS_BRAVE_SEARCH_API_KEY=
# TRELLIS_BRAVE_SEARCH_MONTHLY_LIMIT=1000
# Keep generated worker/gateway values in a private runtime environment file.
# TRELLIS_WEB_WORKER_IMAGE=sha256:<immutable-worker-image-id>
# TRELLIS_WEB_GATEWAY_IMAGE=sha256:<immutable-gateway-image-id>
# TRELLIS_WEB_GATEWAY_CONTAINER=<configured-container-name>
# TRELLIS_WEB_GATEWAY_IPC_VOLUME=<private-ipc-volume>
# TRELLIS_WEB_GATEWAY_SECRET_FILE=/absolute/private/path/gateway-admin
# TRELLIS_WEB_GATEWAY_CONTROL_URL=http://127.0.0.1:8081
# TRELLIS_WEB_GATEWAY_ADMIN_SECRET=
